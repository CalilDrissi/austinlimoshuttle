# Production environment for docker-compose.prod.yml.
# Copy to `.env` on the server and fill in. NEVER commit the real .env.
#
#   cp .env.prod.example .env && nano .env

# --- Database (MariaDB container) ---
DB_NAME=austinlimo
DB_USER=austinlimo
DB_PASSWORD=change-me-strong-random
DB_ROOT_PASSWORD=change-me-strong-random

# --- Django ---
# Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=testmode.austinlimoshuttle.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://testmode.austinlimoshuttle.com

# Google Maps (distance pricing). Can also be set in the dashboard later.
GOOGLE_MAPS_API_KEY=AIza...

# --- Frontend (baked into the browser bundle at build time) ---
NEXT_PUBLIC_API_BASE_URL=https://testmode.austinlimoshuttle.com/api
