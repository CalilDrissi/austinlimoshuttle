# Copy to backend/.env and adjust. NEVER commit the real .env.
# On InMotion this file must live OUTSIDE public_html, or set these values in
# the cPanel Python app's environment-variables panel instead.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Application database (MariaDB 10.11 -- matches InMotion production)
DB_NAME=austinlimo
DB_USER=austinlimo
DB_PASSWORD=localdevonly
DB_HOST=127.0.0.1
DB_PORT=3307

# Sanitised legacy replica, read-only, used by legacy_import commands
LEGACY_DB_NAME=austi118_austinlimo
LEGACY_DB_USER=austinlimo
LEGACY_DB_PASSWORD=localdevonly
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3307

# Google Distance Matrix (server-side only)
GOOGLE_MAPS_API_KEY=

# Fare quote validity
QUOTE_TTL_MINUTES=30

# --- Production only ---
# DJANGO_CSRF_TRUSTED_ORIGINS=https://www.austinlimoshuttle.com
# DJANGO_STATIC_ROOT=/home/austi118/public_html/static
# DJANGO_MEDIA_ROOT=/home/austi118/media
# EMAIL_HOST=mail.austinlimoshuttle.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
