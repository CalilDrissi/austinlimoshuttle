# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# Python backend base URL (no trailing slash needed)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Set to "true" to use mock data (no backend required)
# Set to "false" or remove to hit the real API
NEXT_PUBLIC_USE_MOCKS=true

# Stripe publishable key (needed when payment step is implemented)
NEXT_PUBLIC_STRIPE_PK=pk_test_...

# PayPal client ID (needed when PayPal is implemented)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=...

# Google Maps JS API key for address autocomplete (From/To fields).
# Restrict it in Cloud Console: HTTP referrers + Maps JavaScript API & Places API (New).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
